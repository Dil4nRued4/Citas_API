# Reference for running Spring Boot directly on the host.
# Spring Boot does not load .env automatically; export these variables first.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3307/citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=REPLACE_WITH_THE_MYSQL_PASSWORD
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
SEED_ON_START=false
# Optional one-time update of demo doctors' weekly schedules; does not reset accounts or appointments.
SEED_WEEKLY_SCHEDULES_ON_START=false
SEED_DEFAULT_PASSWORD=REPLACE_WITH_A_PRIVATE_DEVELOPMENT_ONLY_PASSWORD
